generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  MANAGER
}

enum Availability {
  AVAILABLE
  OCCUPIED
}

enum WorkCategory {
  RND_INNOVATION
  DELIVERY_TEAM
}

// Sub-classification inside a category. RESEARCH always means RND_INNOVATION;
// DELIVERY and PM_SUPPORT always mean DELIVERY_TEAM (enforced in src/domain.ts).
enum TaskType {
  RESEARCH
  DELIVERY
  PM_SUPPORT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectKind {
  DELIVERY
  RESEARCH
}

enum EntryKind {
  PROGRESS
  FINDING
  CHALLENGE
  SOLUTION
  OUTCOME
}

enum LinkKind {
  SUPPORTING
  FINAL_REPORT
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  passwordHash    String
  role            Role         @default(DEVELOPER)
  slackUserId     String?
  availability    Availability @default(AVAILABLE)
  statusChangedAt DateTime     @default(now())
  currentTaskId   String?      @unique
  currentTask     Task?        @relation("CurrentTask", fields: [currentTaskId], references: [id], onDelete: SetNull)
  assignedTasks   Task[]       @relation("Assignee")
  createdTasks    Task[]       @relation("Creator")
  entries         TaskEntry[]
  activities      ActivityLog[]
  createdAt       DateTime     @default(now())
}

model Project {
  id          String      @id @default(cuid())
  name        String      @unique
  kind        ProjectKind
  description String?
  tasks       Task[]
  createdAt   DateTime    @default(now())
}

model Task {
  id              String        @id @default(cuid())
  title           String
  description     String?
  expectedOutcome String?
  category        WorkCategory
  type            TaskType
  priority        Priority      @default(MEDIUM)
  status          TaskStatus    @default(NOT_STARTED)
  assigneeId      String?
  assignee        User?         @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User          @relation("Creator", fields: [createdById], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  completedAt     DateTime?
  currentFor      User?         @relation("CurrentTask")
  entries         TaskEntry[]
  links           TaskLink[]
  activities      ActivityLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([assigneeId])
}

model TaskEntry {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  kind      EntryKind
  body      String
  createdAt DateTime  @default(now())

  @@index([taskId])
}

model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  url       String
  kind      LinkKind @default(SUPPORTING)
  createdAt DateTime @default(now())

  @@index([taskId])
}

// Single audit trail: feeds task history, the dashboard activity feed and (later) Slack.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([taskId])
}
