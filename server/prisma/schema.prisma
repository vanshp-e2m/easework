generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  MANAGER
}

// AWAY = off for now (done for today, lunch, leave). An away developer keeps
// their current task so they can resume it in one click.
enum Availability {
  AVAILABLE
  OCCUPIED
  AWAY
}

enum WorkCategory {
  RND_INNOVATION
  DELIVERY_TEAM
}

// Sub-classification inside a category. RESEARCH always means RND_INNOVATION;
// DELIVERY and PM_SUPPORT always mean DELIVERY_TEAM (enforced in src/domain.ts).
enum TaskType {
  RESEARCH
  DELIVERY
  PM_SUPPORT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectKind {
  DELIVERY
  RESEARCH
}

enum EntryKind {
  PROGRESS
  FINDING
  CHALLENGE
  SOLUTION
  OUTCOME
}

enum LinkKind {
  SUPPORTING
  FINAL_REPORT
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  passwordHash    String
  role            Role          @default(DEVELOPER)
  slackUserId     String?
  // The Claude seat (team licence account) this developer uses, e.g. "claude-seat-14".
  claudeSeat      String?
  claudeSeatSetAt DateTime?
  availability    Availability  @default(AVAILABLE)
  statusChangedAt DateTime      @default(now())
  // Several developers can share a current task (owner + collaborators).
  currentTaskId   String?
  currentTask     Task?         @relation("CurrentTask", fields: [currentTaskId], references: [id], onDelete: SetNull)
  assignedTasks   Task[]        @relation("Assignee")
  memberships     TaskMember[]
  createdTasks    Task[]        @relation("Creator")
  entries         TaskEntry[]
  activities      ActivityLog[]
  workSessions    WorkSession[]
  createdAt       DateTime      @default(now())

  @@index([currentTaskId])
}

model Project {
  id          String      @id @default(cuid())
  name        String      @unique
  kind        ProjectKind
  description String?
  tasks       Task[]
  createdAt   DateTime    @default(now())
}

model Task {
  id              String        @id @default(cuid())
  title           String
  description     String?
  expectedOutcome String?
  category        WorkCategory
  type            TaskType
  priority        Priority      @default(MEDIUM)
  status          TaskStatus    @default(NOT_STARTED)
  assigneeId      String?
  assignee        User?         @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User          @relation("Creator", fields: [createdById], references: [id])
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  completedAt     DateTime?
  // Everyone who has this as their current task right now (Occupied or Away).
  currentFor      User[]        @relation("CurrentTask")
  // Developers who joined the owner (assignee) on this task.
  members         TaskMember[]
  entries         TaskEntry[]
  links           TaskLink[]
  activities      ActivityLog[]
  workSessions    WorkSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([category])
  @@index([assigneeId])
}

// A collaborator: a developer working on a task alongside its owner. The owner
// is Task.assignee and never has a row here.
model TaskMember {
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
}

// One stretch of active work by one developer on one task. Opened when they go
// Occupied on it; closed when they switch, finish, go away, or the workday ends.
// Summing these gives real time spent. At most one open session per developer
// (partial unique index in the migration).
model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  endReason String?

  @@index([taskId])
  @@index([userId, startedAt])
}

model TaskEntry {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  kind      EntryKind
  body      String
  createdAt DateTime  @default(now())

  @@index([taskId])
}

// A web link (url) or a file uploaded from someone's computer (the file fields),
// never both (a CHECK constraint in the migration).
model TaskLink {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label      String
  url        String?
  fileName   String?
  fileSize   Int?
  mimeType   String?
  // Name of the stored file in UPLOAD_DIR: random, never derived from user input.
  storageKey String?  @unique
  kind       LinkKind @default(SUPPORTING)
  createdAt  DateTime @default(now())

  @@index([taskId])
}

// Single audit trail: feeds task history, the dashboard activity feed and (later) Slack.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  action    String
  summary   String
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([taskId])
}
