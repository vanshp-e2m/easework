DATABASE_URL="postgresql://ease:ease@localhost:5433/ease_work"
JWT_SECRET="change-me"
PORT=4100

# Team working hours. Developers still active after WORK_END are set Away so
# time isn't counted overnight; someone starting after hours gets OVERTIME_HOURS.
WORK_TIMEZONE="Asia/Kolkata"
WORK_DAYS="Mon,Tue,Wed,Thu,Fri"
WORK_START="10:00"
WORK_END="19:00"
OVERTIME_HOURS=2

# Uploaded task documents are stored here (default: server/uploads). Back this
# folder up together with the database.
# UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25
