DATABASE_URL="postgresql://ease:ease@localhost:5433/ease_work"
JWT_SECRET="change-me"
PORT=4100

# Team working hours. Developers still active after WORK_END are set Away so
# time isn't counted overnight; someone starting after hours gets OVERTIME_HOURS.
WORK_TIMEZONE="Asia/Kolkata"
WORK_DAYS="Mon,Tue,Wed,Thu,Fri"
WORK_START="10:00"
WORK_END="19:00"
OVERTIME_HOURS=2

# Uploaded task documents are stored here (default: server/uploads). Back this
# folder up together with the database.
# UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=25

# Slack: posts to one channel when a developer becomes Available or picks up a task.
# Bot token (xoxb-...) from api.slack.com → your app → Install App; channel ID from
# the channel's details. Leave either empty to turn Slack off.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Where "Open task" links in Slack point.
APP_URL="http://localhost:5173"
