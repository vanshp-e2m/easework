{
  "name": "ease-work",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:local": "npm run -w server db:local",
    "db:setup": "npm run -w server db:deploy && npm run -w server db:seed",
    "dev": "concurrently -n server,client -c blue,green \"npm run -w server dev\" \"npm run -w client dev\""
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@embedded-postgres/windows-x64@16.15.0-beta.19": true
  }
}
